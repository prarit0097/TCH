---
import Icon from './Icon.astro';
import { hospital } from '../data/site';
const path = Astro.url.pathname;
const nav = [['/about/', 'Our hospital'], ['/dr-biswaroop-roy-chowdhury/', 'Dr BRC'], ['/dip-diet/', 'DIP Diet'], ['/resources/', 'Resources'], ['/patient-guide/', 'Patient guide']];
---
<a class="skip-link" href="#main">Skip to content</a>
<div class="topbar"><div class="container"><span><Icon name="pin" size={14}/> Sector 89, Faridabad, Delhi NCR</span><a href={`tel:${hospital.phone}`}>Hospital reception <span>{hospital.displayPhone}</span></a></div></div>
<header class="header">
  <div class="container nav-shell">
    <a class="brand" href="/" aria-label="The Circadian Hospital home">
      <img class="brand-symbol" src="/brand/circadian-logo-256.webp" width="88" height="88" alt="Dr BRC Circadian Hospital official winged-horse logo"/>
      <span class="brand-words"><span class="brand-owner">Dr BRC</span><span class="brand-name">Circadian Hospital</span><span class="brand-hospital">Faridabad</span></span>
    </a>
    <nav class="main-nav" aria-label="Main navigation" id="main-nav">{nav.map(([href, label]) => <a href={href} aria-current={path === href ? 'page' : undefined}>{label}</a>)}<a class="mobile-contact" href="/contact/">Contact reception</a></nav>
    <div class="nav-actions"><button class="icon-button theme-toggle" aria-label="Switch to dark mode" title="Change colour theme" data-theme-toggle><Icon name="moon" /><Icon name="sun" /></button><a class="button button-small header-visit" href="/contact/">Plan a visit <Icon name="northeast" size={17}/></a><button class="icon-button menu-toggle" aria-label="Open navigation" aria-controls="main-nav" aria-expanded="false" data-menu-toggle><Icon name="menu"/><Icon name="close"/></button></div>
  </div>
</header>
