---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import { hospital, faqs, articles, resources } from '../data/site';
const principles = [
 { title: 'Food & nutrition', text: 'Understand the DIP Diet, Dr BRC’s whole-food, plant-based framework.', href: '/dip-diet/', icon: 'leaf' },
 { title: 'Your daily rhythm', text: 'Explore how light, sleep, meals and daily routines relate to health.', href: '/circadian-approach/', icon: 'sun' },
 { title: 'Your individual story', text: 'Start with your history, current treatment and the questions that matter to you.', href: '/patient-guide/', icon: 'plus' },
];
---
<Layout title="Dr BRC Circadian Hospital in Faridabad — 250 beds" description="Dr BRC’s Circadian Hospital in Sector 89, Faridabad. Explore DIP Diet and circadian health education, meet Dr Biswaroop Roy Chowdhury and contact 8512040000.">
 <section class="hospital-hero"><div class="container hero-grid">
  <div class="hero-copy"><p class="location-label"><Icon name="pin" size={17}/> Sector 89, Faridabad</p><h1>Dr BRC’s Circadian Hospital.</h1><p class="hero-description">A 250-bed hospital bringing food, daily rhythms and your individual story into the conversation about health.</p><div class="actions"><a class="button" href="/contact/">Request a visit <Icon name="northeast" size={18}/></a><a class="button button-secondary" href={`tel:${hospital.phone}`}><Icon name="phone" size={18}/> Call reception</a></div><a class="hero-phone" href={`tel:${hospital.phone}`}><span>We’re here to help</span><strong>{hospital.displayPhone}</strong></a></div>
  <figure class="hero-portrait"><div class="portrait-stage"><img src="/images/dr-brc.webp" alt="Dr Biswaroop Roy Chowdhury, known as Dr BRC" width="600" height="900" fetchpriority="high"/></div><figcaption><div><strong>Dr Biswaroop Roy Chowdhury</strong><span>DIP Diet creator and hospital leadership</span></div><a href="/dr-biswaroop-roy-chowdhury/" aria-label="Read about Dr Biswaroop Roy Chowdhury"><Icon name="northeast" size={22}/></a></figcaption></figure>
 </div></section>
 <section class="hospital-strip" aria-label="Hospital at a glance"><div class="container fact-grid"><div><strong>250</strong><span>Hospital beds</span></div><div><strong>Sector 89</strong><span>Faridabad, Delhi NCR</span></div><div><strong>DIP Diet</strong><span>Dr BRC’s nutrition framework</span></div><div><strong>Your first visit</strong><a href="/patient-guide/">Plan with reception <Icon name="northeast" size={16}/></a></div></div></section>
 <section class="section"><div class="container"><div class="section-head"><div><p class="section-label">Our approach</p><h2>Care starts with understanding you.</h2></div><p class="lead">Learn about the thinking behind Dr BRC’s work, then discuss what is appropriate for your needs.</p></div><div class="principles-grid">{principles.map(item => <a class="principle" href={item.href}><span class="principle-icon"><Icon name={item.icon} size={28}/></span><h3>{item.title}</h3><p>{item.text}</p><span class="card-link">Explore <Icon name="northeast" size={17}/></span></a>)}</div></div></section>
 <section class="section surface-soft"><div class="container diet-layout"><div class="diet-intro"><p class="section-label">The DIP Diet system</p><h2>A clearer way to understand your plate.</h2><p class="lead">Disciplined &amp; Intelligent Person’s Diet, developed by Dr BRC.</p><p>His published framework centers on whole plant foods and a structured approach to meals. Here is an introduction to its three ideas.</p><a class="text-link" href="/dip-diet/">Understand the DIP Diet <Icon name="northeast" size={18}/></a></div><div class="diet-system"><figure><img src="/images/brc/dip-fruit.webp" alt="Grapes, bananas and citrus from the official DIP Diet educational material" width="1800" height="679" loading="lazy"/><figcaption>From Dr BRC’s official DIP Diet guide</figcaption></figure><div class="diet-steps"><div><span>01</span><div><h3>Fruit-focused mornings</h3><p>The published guide begins the day with a variety of fruits.</p></div></div><div><span>02</span><div><h3>A vegetable-first meal</h3><p>Its two-plate structure puts vegetables before a cooked vegetarian meal.</p></div></div><div><span>03</span><div><h3>More whole, less refined</h3><p>The framework limits packaged and refined foods.</p></div></div></div><p class="diet-guidance">An educational overview, not a personal prescription. Discuss diet changes and medicines with your treating clinician.</p></div></div></section>
 <section class="section"><div class="container leadership-grid"><figure class="leadership-image"><img src="/images/brc/dr-brc-circadian-clock.webp" alt="Dr BRC explaining a circadian clock at an education session in Malaysia" width="1800" height="1200" loading="lazy"/><figcaption>Dr BRC at a training session in Malaysia, August 2025.</figcaption></figure><div><p class="section-label">Meet Dr BRC</p><h2>The person behind the approach.</h2><p class="lead">Dr Biswaroop Roy Chowdhury is the creator of the DIP Diet and leads the Circadian Hospital.</p><p>His published work explores nutrition, daily routines and health education. Get to know his background, the Circadian Chart and the resources behind his approach.</p><div class="actions"><a class="button" href="/dr-biswaroop-roy-chowdhury/">Read about Dr BRC <Icon name="northeast" size={17}/></a><a class="text-link" href="/gallery/">View official photos <Icon name="northeast" size={17}/></a></div></div></div></section>
 <section class="section knowledge-section"><div class="container"><div class="section-head"><div><p class="section-label">Learn from the source</p><h2>Dr BRC’s ideas, explained.</h2></div><a class="text-link" href="/resources/">All official resources <Icon name="northeast" size={18}/></a></div><div class="resource-grid">{resources.slice(0, 3).map(resource => <a class="resource-card" href={resource.url} target="_blank" rel="noopener noreferrer"><span class="resource-category">{resource.category}</span><h3>{resource.title}</h3><p>{resource.description}</p><span class="card-link">View official resource <Icon name="northeast" size={17}/></span></a>)}</div><p class="resource-note">Resources open on biswaroop.com. A publication is separate from individual medical advice.</p></div></section>
 <section class="section"><div class="container visit-grid"><div class="visit-copy"><p class="section-label">Visit our Faridabad hospital</p><h2>Let’s plan your first conversation.</h2><p class="lead">Speak with reception about your visit, the relevant clinician and what to bring.</p><div class="actions"><a class="button" href="/contact/">Contact reception <Icon name="northeast" size={18}/></a><a class="text-link" href={hospital.whatsapp} target="_blank" rel="noopener noreferrer"><Icon name="whatsapp" size={20}/> WhatsApp us</a></div><a class="visit-phone" href={`tel:${hospital.phone}`}>{hospital.displayPhone}</a></div><div class="visit-address"><Icon name="pin" size={31}/><h3>Sector 89, Faridabad</h3><p>{hospital.address}</p><a class="text-link" href={hospital.maps} target="_blank" rel="noopener noreferrer">Find this address on Maps <Icon name="northeast" size={17}/></a><p class="small">Please confirm availability and arrival arrangements before travelling.</p></div></div></section>
 <section class="section surface-soft"><div class="container faq-grid"><div><p class="section-label">Before you visit</p><h2>Your questions, answered.</h2><p>Practical information to help you take the next step.</p><a class="text-link" href="/patient-guide/">Read the patient guide <Icon name="northeast" size={17}/></a></div><div>{faqs.map(([question, answer]) => <details><summary>{question}<Icon name="plus" size={20}/></summary><p>{answer}</p></details>)}</div></div></section>
 <section class="section"><div class="container"><div class="section-head"><div><p class="section-label">Patient reading</p><h2>Prepare for a better conversation.</h2></div><a class="text-link" href="/journal/">Visit the health journal <Icon name="northeast" size={18}/></a></div><div class="journal-grid">{articles.map((article, i) => <article class="journal-item"><small>{['Daily rhythms', 'Nutrition', 'Visit preparation'][i]}</small><h3>{article.title}</h3><p>{article.intro}</p><a class="text-link" href={`/${article.slug}/`}>Read article <Icon name="northeast" size={17}/></a></article>)}</div></div></section>
</Layout>
