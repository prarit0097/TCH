---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import { pages, articles, resources, type ContentPage } from '../data/site';
export function getStaticPaths() { return [...pages, ...articles].map(page => ({ params: { slug: page.slug }, props: { page } })); }
interface Props { page: ContentPage }
const { page } = Astro.props;
const article = page.slug.startsWith('journal/');
---
<Layout title={page.title} description={page.description} image={page.image} isArticle={article}>
  <section class="page-hero"><div class="container"><nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/">Home</a>{article && <a href="/journal/">Health journal</a>}<span aria-current="page">{article ? 'Article' : page.title}</span></nav><h1>{page.heading}</h1><p class="lead">{page.intro}</p>{article && <p class="article-meta">Patient education from The Circadian Hospital. Sources listed below; no individual medical advice.</p>}</div></section>
  <section class="section"><div class:list={['container', { 'reading-grid': !!page.image }]}>
    {page.slug === 'resources' && <p><a class="text-link" href="/publications/">Explore Dr BRC’s books and publications <Icon name="northeast" size={18}/></a></p>}
    {page.image && <figure class:list={['reading-image', { portrait: page.slug === 'dr-biswaroop-roy-chowdhury' }]}><img src={page.image} alt={page.alt} width={page.slug === 'dr-biswaroop-roy-chowdhury' ? 600 : 1000} height={page.slug === 'dr-biswaroop-roy-chowdhury' ? 900 : 870} loading="eager"/><figcaption>{page.caption}</figcaption></figure>}
    <div class:list={['prose', { 'no-image': !page.image }]}>{page.sections.map(section => <section class="prose-section"><h2>{section.title}</h2><p>{section.text}</p>{section.items && <ul>{section.items.map(item => <li>{item}</li>)}</ul>}</section>)}
      {page.sources && <section class="sources"><h2>Sources and further reading</h2>{page.sources.map(source => <a href={source.url} target="_blank" rel="noopener noreferrer">{source.label}</a>)}</section>}
      <div class="page-cta"><p>For hospital information and visit arrangements, speak with reception.</p><a class="button" href="/contact/">Contact reception <Icon name="northeast" size={18}/></a></div>
    </div>
  </div></section>
  {page.slug === 'resources' && <section class="section surface-soft"><div class="container"><div class="section-head"><h2>Explore the official library.</h2><p class="lead">Guides, books and research pages from biswaroop.com.</p></div><div class="resource-grid">{resources.map(resource => <a class="resource-card" href={resource.url} target="_blank" rel="noopener noreferrer"><span class="resource-category">{resource.category}</span><h3>{resource.title}</h3><p>{resource.description}</p><span class="card-link">View official resource <Icon name="northeast" size={17}/></span></a>)}</div></div></section>}
  {page.slug === 'dip-diet' && <section class="section surface-soft"><div class="container leadership-grid"><figure class="leadership-image"><img src="/images/brc/dip-vegetables.webp" alt="Vegetables shown in the official DIP Diet educational material" width="1800" height="1021" loading="lazy"/><figcaption>Educational illustration from Dr BRC’s published DIP Diet guide.</figcaption></figure><div><p class="section-label">Read the published framework</p><h2>Understand the system before changing your meals.</h2><p class="lead">The official guide describes fruit-focused mornings, a vegetable-first meal structure and whole-food choices. An individual plan must take your current health and treatment into account.</p><a class="text-link" href="https://biswaroop.com/dipdiet/" target="_blank" rel="noopener noreferrer">Read Dr BRC’s official guide <Icon name="northeast" size={18}/></a></div></div></section>}
</Layout>
