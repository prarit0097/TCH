---
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
import { articles } from '../../data/site';
---
<Layout title="Health journal — nutrition, daily rhythms & visiting" description="Read source-backed introductions to circadian rhythms, diet conversations and preparing for your first visit to The Circadian Hospital.">
  <section class="page-hero"><div class="container"><nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/">Home</a><span aria-current="page">Health journal</span></nav><h1>Understand a little more.</h1><p class="lead">Practical reading for better conversations about your health.</p></div></section>
  <section class="section"><div class="container journal-grid">{articles.map((article, i) => <article class="journal-item"><small>{['Daily rhythms', 'Nutrition', 'Visit preparation'][i]}</small><h2 style="font-size:var(--text-title);margin-block:var(--space-lg)">{article.title}</h2><p>{article.intro}</p><a class="text-link" href={`/${article.slug}/`}>Read article <Icon name="northeast" size={18}/></a></article>)}</div></section>
</Layout>
