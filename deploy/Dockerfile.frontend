FROM node:24-alpine AS build
WORKDIR /build
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY astro.config.mjs tsconfig.json ./
COPY src ./src
COPY public ./public
ARG PUBLIC_INDEXABLE=true
ARG PUBLIC_ENQUIRY_API=/api
ENV PUBLIC_INDEXABLE=$PUBLIC_INDEXABLE PUBLIC_ENQUIRY_API=$PUBLIC_ENQUIRY_API
RUN npm run build
FROM nginx:1.28-alpine
COPY --from=build /build/dist /srv/circadian
COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf
